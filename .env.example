# Copy this file to .env for local development.
# .env is gitignored. Railway never reads .env or this example.
# Set the Railway variables in the Railway dashboard (see the block at the bottom).
# Pushing this repository does not change either place.

# --- Local -------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-local-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Leave DATABASE_URL unset to keep using SQLite at db.sqlite3.
# Uncomment to point this machine at your own Postgres instead.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/bizserve
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=bizserve
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Optional. Unset means the in-memory channel layer and no remote Redis.
# REDIS_URL=redis://localhost:6379/0

# Email. Unset uses the development backend (console + tmp/email_outbox).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=2c2d Solutions <noreply@example.com>

# --- Railway dashboard only (do not copy these into .env) -------------------
# DEBUG=False
# SECRET_KEY=<generate a long random string; required when DEBUG=False>
# DATABASE_URL=${{Postgres.DATABASE_URL}}
#    The Postgres service name in ${{...}} must match the name you gave it.
# ALLOWED_HOSTS=your-custom-domain.com
#    Needed only for a custom domain. *.up.railway.app is added automatically.
# CSRF_TRUSTED_ORIGINS=https://your-custom-domain.com
# REDIS_URL=${{Redis.REDIS_URL}}
#    Only if you add a Redis service. The app does not require Redis to boot.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=2c2d Solutions <noreply@your-domain.com>
#
# Uploaded files: add a volume mounted at /data. MEDIA_ROOT follows
# RAILWAY_VOLUME_MOUNT_PATH, which Railway sets. Without a volume, uploads
# live on the container disk and disappear on the next deploy.
